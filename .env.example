# Database (local libSQL file; production: libsql://xxx.turso.io)
DATABASE_URL="file:dev.db"
# DATABASE_AUTH_TOKEN=""

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=""

# AES-256-GCM key for secrets stored in the settings table (base64, 32 bytes)
# openssl rand -base64 32
ASMS_ENCRYPTION_KEY=""

# Protects /api/cron/cleanup
CRON_SECRET=""

# Required on public deployments to claim the first admin at /setup
SETUP_TOKEN=""

# Optional bootstrap fallbacks; values saved in the admin panel take precedence
# RESEND_API_KEY=""
# RESEND_WEBHOOK_SECRET=""

# sb.sb sign-in (standard OIDC). Used until the provider is saved in the admin
# panel; saving it there — including switching it off — wins from then on.
# OIDC_ISSUER="https://sb.sb/oidc"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# OIDC_REDIRECT_URI="https://your.domain/api/auth/callback/sb"
# OIDC_SCOPES="openid profile email offline_access"
